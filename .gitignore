# --- Vivado generated artifacts ---
# Build cache, HW sessions, runs, sim outputs — all regenerable
baseline.cache/
baseline.hw/
baseline.ip_user_files/
baseline.runs/
baseline.sim/

# Design checkpoints — binary synth artifacts, regenerable
*.dcp

# Vivado journals & logs
*.jou
*.log
*.backup.jou
*.backup.log
.Xil/

# DFX runtime (Vivado auto-generated)
dfx_runtime.txt

# --- OS / editor cruft ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
.claude/

# --- Python / local datasets ---
__pycache__/
*.py[cod]
training/data/

# --- Temporary analysis workspace ---
tmp/

# VS Code: ignore user prefs, keep shared tasks/launch/settings
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json

# --- Build artifacts ---
build/

# --- OpenROAD outputs (added later) ---
# Exclude generated results, keep configs
**/results/
**/reports/
**/logs/
**/objects/

# Archived legacy experiments (manifests and restoration notes remain visible)
archive/**/*.zip

# Local review workspaces and simulator caches
.report_review/
.submission_review/
.figure_review/
~$*
*.dmp
*.pb
*.vcd
*.fst
*.wdb
*.vvp

# Report evidence is intentionally versioned
!docs/report_data/**/*.log
!submission/IDEC2026/04_synthesis/reports/
!submission/IDEC2026/04_synthesis/reports/**
!submission/IDEC2026/05_gate_project/verification/*.log
