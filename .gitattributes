# Keep generated and reference artifacts out of textual diffs.
*.pdf binary
*.png binary
*.pptx binary
*.hwp binary
*.pt binary

# Preserve source files as text across platforms.
*.v text
*.tcl text
*.py text
*.md text
*.json text
*.csv text
*.svg text

# Tool-generated reports/plots preserve their producer's whitespace.
*_synth_stat.txt -whitespace
*.svg -whitespace

# Frozen designated b1_g1 bytes: preserve SHA-256 across checkouts.
verilog/*.v -text
docs/designated_final/*.rpt -whitespace
docs/designated_final/synth_stat.txt -whitespace
submission/** -text
docs/report_data/final_delivery/** -text
*.sh text eol=lf

# Preserve the submitted payload byte-for-byte, including its hash inventory.
submission/IDEC2026_FREE_TOPIC/** -text

# Preserve archived measurement inputs and their recorded SHA-256 hashes.
free_topic_vgg/verification/**/vectors*/** -text -whitespace
docs/experiment_results/free_topic/vgg_conv1_conv2_ppa/** -text -whitespace
